{
  "mcpServers": {
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${HIGGSFIELD_ACCESS_TOKEN}"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PWD}/.claude/higgsfield-credentials-init.sh"
          }
        ]
      }
    ]
  }
}
